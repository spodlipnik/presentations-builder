{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(pytest*)",
      "Bash(which *)",
      "Bash(wc -l*)",
      "Bash(find skills:*)",
      "Bash(find references:*)",
      "Bash(find assets:*)",
      "Bash(grep -rn*)"
    ]
  }
}
